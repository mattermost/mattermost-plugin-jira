# Copy to .env (gitignored). Read by docker compose and by the Playwright configs; CI uses GitHub secrets instead.

# Local stack. Change MM_PORT if 8065 is taken by another Mattermost; use an arm64 image on Apple Silicon.
# The real-Jira suite needs MM_PORT to match the callback URL registered in the Atlassian OAuth app (8066).
MM_PORT=8065
MM_IMAGE=mattermostdevelopment/mattermost-enterprise-edition:master

# Real Jira Cloud (npm run test:real-cloud, real:login, test:real-jira)
JIRA_CLOUD_URL=https://your-site.atlassian.net
JIRA_CLOUD_PROJECT_KEY=IT

# Jira administrator on the test site
JIRA_CLOUD_ADMIN_EMAIL=
JIRA_CLOUD_ADMIN_API_TOKEN=

# Regular Jira user on the test site
JIRA_CLOUD_USER_EMAIL=
JIRA_CLOUD_USER_API_TOKEN=

# The regular user's Atlassian password and two-step verification setup key (test:real-jira, real:login).
# TOTP secret = the key behind "Can't scan the QR code?" when enrolling an authenticator app at id.atlassian.com.
JIRA_CLOUD_USER_PASSWORD=
JIRA_CLOUD_USER_TOTP_SECRET=

# Atlassian OAuth 2.0 (3LO) app owned by the admin account
JIRA_CLOUD_OAUTH_CLIENT_ID=
JIRA_CLOUD_OAUTH_CLIENT_SECRET=
